# --- secrets -----------------------------------------------------------------
# The API key lives here and must never reach the repository. On Render it is
# set as an environment variable instead.
.env
.env.local

# --- environments ------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]

# --- data --------------------------------------------------------------------
# Recordings and transcripts of other people's lectures: not ours to publish.
samples/
transcripts/
*.wav
*.mp3
*.m4a
*.mp4

# Course memory and cached definitions — machine state, regenerated on use.
# The star catches the copies set aside before a clean test run
# (glossary-run1, glossary-0926-night, ...).
glossary/
glossary*/

# Files the Claude desktop app saves into the project folder.
Claude outputs/

# The before/after proof for the demo. Keep the files, keep them out of git:
# they contain a full lecture transcript.
evidence/

# --- editors and systems ------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db